MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=love_memory
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
AUTH_EMAIL_FROM=LoveMemory <hello@example.com>
RESEND_API_KEY=
ASSET_ORIGIN=
BLOB_READ_WRITE_TOKEN=
# Development/E2E only: STORAGE_DRIVER=local stores media under .tmp/object-storage and is refused
# on every Vercel deployment. It needs a 32+ character LOCAL_OBJECT_STORAGE_SECRET and APP_URL.
STORAGE_DRIVER=
LOCAL_OBJECT_STORAGE_SECRET=
MEDIA_WORKER_MODE=inline
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
TECHNICAL_SPIKES_ENABLED=false
TECHNICAL_SPIKE_TOKEN=
# Internal paid-plan grant: the Standard plan without payment until checkout exists (every owner can
# always publish on Free). Only the exact value `true` enables it, and it is always off when
# VERCEL_ENV=production. Set `true` on the dev and stg Preview branches.
INTERNAL_PLAN_GRANT_ENABLED=false
# First-party funnel analytics. Only the exact value `true` enables it, and only with a dedicated
# ANALYTICS_GIFT_REF_SECRET of at least 32 characters (48 random bytes as base64url, distinct per
# environment). Off by default; Production stays off until the Product Owner turns it on.
ANALYTICS_ENABLED=false
ANALYTICS_GIFT_REF_SECRET=
