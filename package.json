{
  "name": "love-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser-first platform for creating private, interactive memory gifts.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.13.0 <27",
    "pnpm": ">=10.22.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:templates": "pnpm --filter @love-memory/template-memory-box-spike build",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=apps/web/.env.local --conditions=react-server --import tsx scripts/database.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=apps/web/.env.local --conditions=react-server --import tsx scripts/database.ts seed",
    "db:verify": "node --env-file-if-exists=.env --env-file-if-exists=apps/web/.env.local --conditions=react-server --import tsx scripts/database.ts verify",
    "db:verify-gifts": "node --env-file-if-exists=.env --env-file-if-exists=apps/web/.env.local --conditions=react-server --import tsx scripts/verify-gift-persistence.ts",
    "dev": "turbo run dev --filter=@love-memory/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "start": "pnpm --filter @love-memory/web start",
    "test": "pnpm build:templates && vitest run",
    "test:coverage": "pnpm build:templates && vitest run --coverage",
    "test:e2e": "node --env-file-if-exists=.env --env-file-if-exists=apps/web/.env.local node_modules/@playwright/test/cli.js test --project=chromium --project=mobile-chromium",
    "test:e2e:chrome": "node --env-file-if-exists=.env --env-file-if-exists=apps/web/.env.local node_modules/@playwright/test/cli.js test --project=installed-chrome --workers=1",
    "test:secrets": "node scripts/check-secrets.mjs",
    "test:spikes": "node scripts/verify-live-spikes.mjs",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.json && turbo run type-check"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@love-memory/template-sdk": "workspace:*",
    "@playwright/test": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
